# =============================================================
# Application Settings
# =============================================================
APP_NAME="Donation Management System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# =============================================================
# Database
# =============================================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/donation_db
DB_ECHO=false

# =============================================================
# JWT Authentication
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER use a short or guessable key in production.
# =============================================================
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================
# CORS
# WARNING: Never use * in production — list exact frontend origins only.
# =============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================
# File Storage
# =============================================================
MEDIA_PATH=./media
MAX_UPLOAD_SIZE_MB=10

# =============================================================
# AI Detection
# =============================================================
DETECTION_CONFIDENCE=0.40
MODEL_PATH=./models/best.pt
USE_MOCK_DETECTOR=true

# =============================================================
# Matching Engine
# =============================================================
MATCH_SCORE_THRESHOLD=0.50
MATCH_TOP_N=3
MATCH_EXPIRY_HOURS=48

# =============================================================
# Testing
# Create this DB manually: createdb donation_test_db
# =============================================================
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/donation_test_db
